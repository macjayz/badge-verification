{
  "name": "badge-verification",
  "version": "1.0.0",
  "description": "Sybil-resistant credential platform: DID and social verification, then soulbound badges.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typeorm": "typeorm-ts-node-commonjs -d src/db/datasource.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run:prod": "typeorm -d dist/db/datasource.js migration:run",
    "migrate": "npm run migration:run",
    "deploy:sepolia": "npx hardhat run scripts/deploy.ts --network sepolia",
    "deploy:base-sepolia": "npx hardhat run scripts/deploy.ts --network baseSepolia",
    "verify:contract": "npx hardhat run scripts/verify.ts --network sepolia",
    "compile": "npx hardhat compile",
    "test:contract": "npx hardhat test"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.14",
    "siwe": "^2.3.2",
    "typeorm": "^0.3.27",
    "winston": "^3.18.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.25",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "globals": "^17.14.0",
    "hardhat": "^2.27.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "keywords": [],
  "author": "Mangai Machen John",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/macjayz/badge-verification.git"
  },
  "engines": {
    "node": ">=22"
  }
}
