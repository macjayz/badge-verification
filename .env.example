# Copy this file to .env and you're ready to go:
#   cp .env.example .env
#
# Everything below has a working default for local testing via
# `docker-compose up -d`. Nothing marked OPTIONAL is required to run
# the app, browse the UI, or exercise the badge/eligibility flows.

# Server
NODE_ENV=development
PORT=3000

# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=badgedb

# Hosted Postgres (Render, Railway, Heroku, Neon, Supabase, ...)
# If DATABASE_URL is set it replaces all five DB_* values above.
# Nearly all of these providers require TLS, so set DB_SSL=true as well.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true
# Some providers terminate TLS with a private CA that isn't in the system
# trust store; if you hit "self-signed certificate in certificate chain",
# set this to false.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6380

# JWT
# REQUIRED in production: the app refuses to start if this is unset, still the
# development default, or shorter than 32 characters.
#   generate one with:  openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me

# Admin panel login
# REQUIRED in production: the app refuses to start while ADMIN_PASSWORD is
# unset or still 'admin123'.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
# Console logging is always on. Set LOG_TO_FILE=true to also write
# error.log/combined.log (defaults to on in development, off in production).
# LOG_TO_FILE=false
# LOG_LEVEL=info

# Web3 / minting
# Leave USE_REAL_ADAPTERS=false (or unset) to run with mock on-chain
# transactions and mock DID verification -- no wallet, RPC, or API
# keys needed. Set it to true only once you've filled in the
# OPTIONAL blocks below.
USE_REAL_ADAPTERS=false
DEFAULT_CHAIN_ID=31337

# --- OPTIONAL: only needed with USE_REAL_ADAPTERS=true ---

# On-chain minting (Sepolia/Mumbai testnets)
# CONTRACT_ADDRESS=
# SEPOLIA_RPC_URL=
# MUMBAI_RPC_URL=
# DEPLOYER_PRIVATE_KEY=      # never a mainnet key with real funds

# Privado ID (formerly Polygon ID) - DID verification
# Works against Privado's public endpoint without a key (rate-limited)
# PRIVADO_API_KEY=
# PRIVADO_VERIFIER_API_URL=
# PRIVADO_CHAIN_ID=

# IdOS - secondary DID verification
# IDOS_API_KEY=
# IDOS_API_URL=

# Twitter OAuth - social verification
# Create an app at https://developer.twitter.com to get these
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TWITTER_REDIRECT_URI=http://localhost:3001/api/verify/twitter/callback
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# TWITTER_BEARER_TOKEN=

# Discord OAuth - social verification
# Create an app at https://discord.com/developers/applications to get these
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:3001/api/verify/discord/callback
