# Copy to .env for local development:
#   cp .env.example .env
#
# The defaults run the app against `docker compose up -d postgres redis` with stub
# adapters. Nothing marked OPTIONAL is needed to run the app locally.

# Server
NODE_ENV=development
PORT=3000

# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=badgedb

# Hosted Postgres (Render, Railway, Heroku, Neon, Supabase, ...)
# If DATABASE_URL is set it replaces all five DB_* values above.
# Nearly all of these providers require TLS, so set DB_SSL=true as well.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true
# Some providers terminate TLS with a private CA that isn't in the system
# trust store; if you hit "self-signed certificate in certificate chain",
# set this to false.
# DB_SSL_REJECT_UNAUTHORIZED=true

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6380

# JWT
# REQUIRED in production: the app refuses to start if this is unset, still the
# development default, or shorter than 32 characters.
#   generate one with:  openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me

# Admin panel login
# REQUIRED in production: the app refuses to start while ADMIN_PASSWORD is
# unset or still 'admin123'.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
# Console logging is always on. Set LOG_TO_FILE=true to also write
# error.log/combined.log (defaults to on in development, off in production).
# LOG_TO_FILE=false
# LOG_LEVEL=info

# Web3 / minting
# false: the identity check and mints are simulated, no wallet or keys needed. Local development only;
# production refuses to start unless this is true and the minting values below are set.
USE_REAL_ADAPTERS=false
DEFAULT_CHAIN_ID=31337

# --- OPTIONAL locally, REQUIRED in production ---

# On-chain minting. RPC_URL overrides the built-in public endpoint for DEFAULT_CHAIN_ID
# (1, 11155111, 8453, 84532, 137, 80002, 31337).
# CONTRACT_ADDRESS=
# DEPLOYER_PRIVATE_KEY=      # a dedicated minting key, never one holding real funds
# RPC_URL=
# SEPOLIA_RPC_URL=
# BASE_SEPOLIA_RPC_URL=

# Contract deployment (scripts/deploy.ts)
# BADGE_COLLECTION_NAME=Verified Badges
# BADGE_COLLECTION_SYMBOL=VBADGE
# BADGE_METADATA_BASE_URL=https://example.com/badges
# ETHERSCAN_API_KEY=

# Privado ID (formerly Polygon ID) - identity verification
# Works against Privado's hosted verifier without a key. In production PRIVADO_ALLOWED_ISSUERS is
# REQUIRED and must list the issuer DIDs you trust; "*" lets anyone self-issue a credential.
# PRIVADO_ALLOWED_ISSUERS=did:iden3:privado:main:...
# PRIVADO_CHAIN_ID=80002          # 80002 Polygon Amoy test network, 137 Polygon
# PRIVADO_VERIFIER_API_URL=https://verifier-backend.privado.id
# PRIVADO_API_KEY=
# The credential the wallet must prove. Default: KYCAgeCredential showing the holder is over 18.
# PRIVADO_CREDENTIAL_TYPE=KYCAgeCredential
# PRIVADO_CREDENTIAL_CONTEXT=https://raw.githubusercontent.com/iden3/claim-schema-vocab/main/schemas/json-ld/kyc-v3.json-ld
# PRIVADO_CREDENTIAL_SUBJECT={"birthday":{"$lt":20080101}}

# Twitter OAuth - social verification
# Create an app at https://developer.twitter.com to get these
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TWITTER_REDIRECT_URI=http://localhost:3001/api/verify/twitter/callback
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# TWITTER_BEARER_TOKEN=
# X's lower API tiers cannot look up follows, so follow rules fail by default.
# Set to true to accept a connected X account in place of a verified follow.
# TWITTER_ACCEPT_CONNECTION_AS_FOLLOW=false

# Discord OAuth - social verification
# Create an app at https://discord.com/developers/applications to get these
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:3001/api/verify/discord/callback
